# Telegram
BOT_TOKEN=123456:replace-me
# Числовой id канала/чата, куда бот может слать служебные логи (необязательно)
LOG_CHAT_ID=

# Админы (telegram user id через запятую)
ADMIN_TELEGRAM_IDS=123456789

# Каналы-источники новостей: бот должен быть админом, чтобы получать channel_post.
# Формат: -100123,-100456
NEWS_CHANNEL_IDS=

# PostgreSQL (локально или connection string из Supabase → Settings → Database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fuel_bot?schema=public

# Подписка (Telegram Stars). 1 неделя триала, затем списание Stars.
TRIAL_DAYS=7
# TODO: подобрать фактическое количество Stars под ~$2/мес
SUBSCRIPTION_STARS=100
SUBSCRIPTION_TITLE=Заправься умно
SUBSCRIPTION_PAYLOAD=fuel_bot_month

# Планировщик
TZ=Europe/Chisinau

# Парсинг сайтов (пока заглушка; URL через запятую)
NEWS_SITE_URLS=

# Окружение: development | production
NODE_ENV=development
