# Telegram — токен от @BotFather
BOT_TOKEN=REPLACE_ME

# Твой numeric id от @userinfobot (можно несколько через запятую)
ADMIN_TELEGRAM_IDS=REPLACE_ME

# Необязательно: отдельный чат для логов. Если пусто — пишем админам в личку с ботом.
LOG_CHAT_ID=

# Supabase → Project Settings → Database
# DATABASE_URL: Connection string, режим Session pooler (порт 6543) + pgbouncer=true
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: Direct connection (порт 5432) — для prisma migrate
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

TRIAL_DAYS=3
SUBSCRIPTION_STARS=100
SUBSCRIPTION_TITLE=Заправься умно
SUBSCRIPTION_PAYLOAD=fuel_bot_month

TZ=Europe/Chisinau
TELEGRAM_PREVIEW_CHANNELS=anre_md,benzin_md,petrolmd,newsmakerlive,ro_newsmakerlive,pointnews,PointNewsRo,pridnestrovec,most_dnestr,novostipmrcom
NEWS_SITE_URLS=https://newsmaker.md/ru/feed/,https://newsmaker.md/ro/feed/,https://point.md/ru/rss/all,https://agora.md/rss,https://novostipmr.com/ru/rss.xml,https://pmr-news.ru/,https://tiraspol-news.ru/
NEWS_CHANNEL_IDS=
NODE_ENV=development
